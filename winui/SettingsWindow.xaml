<Window
    x:Class="FluentAgentBar.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer
            x:Name="SettingsScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentPanel"
                HorizontalAlignment="Center"
                Margin="40"
                MaxWidth="760"
                Spacing="16">
                <TextBlock
                    Text="Settings"
                    Style="{ThemeResource TitleTextBlockStyle}" />

                <StackPanel Spacing="8">
                    <StackPanel Spacing="0">
                        <TextBlock
                            Text="General"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Refresh and surface preferences"
                            Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>

                    <toolkit:SettingsCard
                        x:Name="RefreshIntervalCard"
                        Header="Refresh interval"
                        Description="Seconds between usage refreshes">
                        <NumberBox
                            x:Name="RefreshIntervalNumberBox"
                            Width="184"
                            Minimum="30"
                            Maximum="3600"
                            SmallChange="30"
                            SpinButtonPlacementMode="Inline"
                            ValidationMode="InvalidInputOverwritten"
                            ValueChanged="OnRefreshIntervalValueChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="WidgetGlowCard"
                        Header="Widget glow"
                        Description="Faint provider-colored tint behind the taskbar widget">
                        <ToggleSwitch
                            x:Name="WidgetGlowToggle"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="OnWidgetGlowToggled" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="BackdropCard"
                        Header="Backdrop"
                        Description="Flyout material">
                        <ComboBox
                            x:Name="BackdropComboBox"
                            Width="144"
                            SelectionChanged="OnBackdropSelectionChanged">
                            <ComboBoxItem Content="Acrylic" />
                            <ComboBoxItem Content="Solid" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="0">
                            <TextBlock
                                Text="Profiles"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Profile homes and account actions"
                                Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnAddProfileClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="New profile" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ProfilesPanel" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
