<Window
    x:Class="FluentAgentBar.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentAgentBar">

    <Grid
        x:Name="Shell"
        Width="400"
        VerticalAlignment="Top"
        Opacity="0"
        Background="Transparent"
        RenderTransformOrigin="0.5,1">
        <Grid.Resources>
            <CubicEase x:Key="OpenEase" EasingMode="EaseOut" />
            <Storyboard x:Key="OpenStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="Shell"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <StaticResource ResourceKey="OpenEase" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="ShellTransform"
                    Storyboard.TargetProperty="TranslateY"
                    From="8"
                    To="0"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <StaticResource ResourceKey="OpenEase" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CloseStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="Shell"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.10">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="ShellTransform"
                    Storyboard.TargetProperty="TranslateY"
                    From="0"
                    To="8"
                    Duration="0:0:0.10">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <Grid.RenderTransform>
            <CompositeTransform x:Name="ShellTransform" TranslateY="8" />
        </Grid.RenderTransform>

        <Border
            Padding="16"
            Background="Transparent">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="0">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Fluent AgentBar" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind LastRefreshText}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind CodexSwitchStatusText}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind CodexSwitchStatusVisibility}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind IntervalText}" />
                </Grid>

                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Providers}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:ProviderUsage">
                                <Border
                                    Padding="14,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{x:Bind}"
                                    PointerPressed="OnProviderHeaderPressed">
                                    <StackPanel Spacing="10">
                                        <Grid
                                            Background="Transparent"
                                            ColumnDefinitions="Auto,*,Auto,Auto"
                                            ColumnSpacing="8">
                                            <Viewbox
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <Path
                                                    Data="{x:Bind LogoGeometry}"
                                                    Fill="{x:Bind LogoBrush}" />
                                            </Viewbox>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ProfileCountText}" />
                                            <FontIcon
                                                Grid.Column="3"
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind HistoryChevronGlyph, Mode=OneWay}"
                                                Visibility="{x:Bind HistoryToggleVisibility}" />
                                        </Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TokensText}"
                                            Visibility="{x:Bind TokensVisibility}" />

                                        <StackPanel
                                            Loaded="OnHistoryPanelLoaded"
                                            Spacing="6"
                                            Visibility="{x:Bind HistoryVisibility, Mode=OneWay}">
                                            <ItemsRepeater ItemsSource="{x:Bind HistoryBars}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout
                                                        ItemsStretch="Fill"
                                                        MaximumRowsOrColumns="7"
                                                        MinColumnSpacing="6"
                                                        MinItemWidth="28" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:HistoryBar">
                                                        <Grid
                                                            Height="88"
                                                            Background="Transparent"
                                                            ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                            <StackPanel
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Bottom"
                                                                Spacing="5">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="10"
                                                                    FontWeight="{x:Bind LabelWeight}"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind ValueText}" />
                                                                <Border
                                                                    Width="10"
                                                                    Height="{x:Bind BarHeight}"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{x:Bind BarBrush}"
                                                                    CornerRadius="5"
                                                                    Opacity="{x:Bind BarOpacity}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <Border
                                                Height="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Opacity="0.6" />
                                            <ItemsRepeater ItemsSource="{x:Bind HistoryBars}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout
                                                        ItemsStretch="Fill"
                                                        MaximumRowsOrColumns="7"
                                                        MinColumnSpacing="6"
                                                        MinItemWidth="28" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:HistoryBar">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="{x:Bind LabelWeight}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind DayLabel}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind HistorySummaryText}" />
                                        </StackPanel>

                                        <ItemsRepeater ItemsSource="{x:Bind Profiles}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="10" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProfileUsage">
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <TextBlock
                                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                                Text="{x:Bind Label}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind DetailText}" />
                                                            <Button
                                                                Grid.Column="2"
                                                                MinWidth="68"
                                                                Height="28"
                                                                Padding="8,2"
                                                                Click="OnCodexSwitchClick"
                                                                IsEnabled="{x:Bind CanSwitchCodexAccount}"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="{x:Bind CodexSwitchTooltip}"
                                                                Visibility="{x:Bind CodexSwitchVisibility}">
                                                                <StackPanel
                                                                    HorizontalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="6">
                                                                    <FontIcon
                                                                        FontSize="12"
                                                                        Glyph="{x:Bind CodexSwitchGlyph}" />
                                                                    <TextBlock
                                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind CodexSwitchText}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                        <Grid
                                                            Grid.Row="1"
                                                            ColumnDefinitions="48,*,38"
                                                            ColumnSpacing="8">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="5h" />
                                                            <ProgressBar
                                                                Grid.Column="1"
                                                                MinHeight="5"
                                                                Height="5"
                                                                VerticalAlignment="Center"
                                                                Maximum="100"
                                                                Foreground="{x:Bind AccentBrush}"
                                                                Value="{x:Bind RemainingPercent}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontWeight="SemiBold"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                TextAlignment="Right"
                                                                Text="{x:Bind RemainingText}" />
                                                        </Grid>
                                                        <Grid
                                                            Grid.Row="2"
                                                            ColumnDefinitions="48,*,38"
                                                            ColumnSpacing="8">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="Weekly" />
                                                            <ProgressBar
                                                                Grid.Column="1"
                                                                MinHeight="5"
                                                                Height="5"
                                                                VerticalAlignment="Center"
                                                                Maximum="100"
                                                                Foreground="{x:Bind AccentBrush}"
                                                                Value="{x:Bind WeeklyPercent}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontWeight="SemiBold"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                TextAlignment="Right"
                                                                Text="{x:Bind WeeklyText}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            HorizontalAlignment="Right"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind ResetsText}"
                                                            Visibility="{x:Bind ResetsVisibility}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Click="OnRefreshClick">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Click="OnConfigClick">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="Config" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Padding="8,4"
                        Click="OnSettingsClick">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xE713;" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="Settings" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
